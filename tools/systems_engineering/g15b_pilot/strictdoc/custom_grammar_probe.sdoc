[DOCUMENT]
TITLE: StrictDoc 0.30.1 custom-grammar capability probe
UID: PILOT-CUSTOM-GRAMMAR-PROBE

[GRAMMAR]
ELEMENTS:
- TAG: REQUIREMENT
  PROPERTIES:
    IS_COMPOSITE: False
  FIELDS:
  - TITLE: UID
    TYPE: String
    REQUIRED: True
  - TITLE: TITLE
    TYPE: String
    REQUIRED: True
  - TITLE: STATEMENT
    TYPE: String
    REQUIRED: True
  - TITLE: ACCEPTANCE
    TYPE: String
    REQUIRED: True
  RELATIONS:
