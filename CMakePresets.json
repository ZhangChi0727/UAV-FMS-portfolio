{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "development-readiness-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_LEGACY_NAVIGATION": "OFF",
        "BUILD_DEVELOPMENT_READINESS_SMOKE": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "development-readiness-debug",
      "displayName": "Development readiness (Debug)",
      "inherits": "development-readiness-base",
      "binaryDir": "${sourceDir}/build/development-readiness/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "development-readiness-release",
      "displayName": "Development readiness (Release)",
      "inherits": "development-readiness-base",
      "binaryDir": "${sourceDir}/build/development-readiness/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "b0-controller-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_LEGACY_NAVIGATION": "OFF",
        "BUILD_DEVELOPMENT_READINESS_SMOKE": "OFF",
        "BUILD_B0_CONTROLLER": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "b0-controller-debug",
      "displayName": "B0 controller (Debug)",
      "inherits": "b0-controller-base",
      "binaryDir": "${sourceDir}/build/b0-controller/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "b0-controller-release",
      "displayName": "B0 controller (Release)",
      "inherits": "b0-controller-base",
      "binaryDir": "${sourceDir}/build/b0-controller/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    {
      "name": "development-readiness-debug",
      "configurePreset": "development-readiness-debug"
    },
    {
      "name": "development-readiness-release",
      "configurePreset": "development-readiness-release"
    },
    {
      "name": "b0-controller-debug",
      "configurePreset": "b0-controller-debug"
    },
    {
      "name": "b0-controller-release",
      "configurePreset": "b0-controller-release"
    }
  ],
  "testPresets": [
    {
      "name": "development-readiness-debug",
      "configurePreset": "development-readiness-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "development-readiness-release",
      "configurePreset": "development-readiness-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "b0-controller-debug",
      "configurePreset": "b0-controller-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "b0-controller-release",
      "configurePreset": "b0-controller-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
