{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gnc-controller-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gnc-controller-debug",
      "displayName": "GNC controller (Debug)",
      "inherits": "gnc-controller-base",
      "binaryDir": "${sourceDir}/gnc_baseline/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "gnc-controller-release",
      "displayName": "GNC controller (Release)",
      "inherits": "gnc-controller-base",
      "binaryDir": "${sourceDir}/gnc_baseline/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    {
      "name": "gnc-controller-debug",
      "configurePreset": "gnc-controller-debug"
    },
    {
      "name": "gnc-controller-release",
      "configurePreset": "gnc-controller-release"
    }
  ],
  "testPresets": [
    {
      "name": "gnc-controller-debug",
      "configurePreset": "gnc-controller-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gnc-controller-release",
      "configurePreset": "gnc-controller-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
