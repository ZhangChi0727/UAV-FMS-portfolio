{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uav-fms:b0:g3a:evidence:v1",
  "title": "G3-A development raw evidence v1",
  "description": "Shape only. Accepted external authority and g3a_evidence_spec.md semantic checks are mandatory. Failed/partial records are retainable, not passes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "conventions", "completion", "termination_reason", "parameter_objects", "lifecycle_observations", "profiles", "reported_counts"],
  "properties": {
    "schema_version": {"const": "b0-g3a-evidence/v1"},
    "identity": {"$ref": "#/$defs/identity"},
    "conventions": {"$ref": "#/$defs/conventions"},
    "completion": {"enum": ["complete", "partial"]},
    "termination_reason": {"type": ["string", "null"]},
    "parameter_objects": {"type": "array", "items": {"$ref": "#/$defs/parameter_object"}},
    "lifecycle_observations": {"type": "array", "items": {"$ref": "#/$defs/lifecycle_observation"}},
    "profiles": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/profile"}},
    "reported_counts": {"$ref": "#/$defs/counts"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "nullable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "git_sha1": {"type": "string", "pattern": "^[0-9A-Fa-f]{40}$"},
    "id": {"type": "string", "minLength": 1},
    "nullable_ref": {"type": ["string", "null"], "minLength": 1},
    "tick": {"type": "integer", "minimum": 0},
    "float64": {
      "type": "string",
      "pattern": "^(?:-?0x(?:[01]\\.[0-9a-f]{13}p[+-][0-9]+|0\\.0p\\+0)|nan|inf|-inf)$",
      "description": "Semantic acceptance requires finite canonical binary64 float.hex. Nonfinite tokens retain failed raw/negative tests only."
    },
    "nullable_float64": {"anyOf": [{"$ref": "#/$defs/float64"}, {"type": "null"}]},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/float64"}},
    "quat": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/float64"}},
    "mat3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vec3"}},
    "flags3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "boolean"}},
    "parameter_object": {
      "type": "object", "additionalProperties": false,
      "required": ["parameter_object_id", "kind", "capture_kind", "values_sha256", "values"],
      "properties": {
        "parameter_object_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["g1", "estimator", "controller"]},
        "capture_kind": {"enum": ["object_values", "constructor_fields"]},
        "values_sha256": {"$ref": "#/$defs/sha256"}, "values": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "g1"}}}, "then": {"properties": {"values": {"$ref": "#/$defs/g1_parameter_values"}}}},
        {"if": {"properties": {"kind": {"const": "estimator"}}}, "then": {"properties": {"values": {"$ref": "#/$defs/estimator_parameter_values"}}}},
        {"if": {"properties": {"kind": {"const": "controller"}}}, "then": {"properties": {"values": {"$ref": "#/$defs/controller_parameter_values"}}}}
      ],
      "description": "Actual observed object values after runtime begins, never an input authority generated by a pre-run DUT construction. Values digest is independently recomputed."
    },
    "g1_parameter_values": {
      "type": "object", "additionalProperties": false,
      "required": ["inertia_kg_m2", "actuator_time_constant_s", "actuator_limits_Nm", "gravity_n_m_s2", "gyro_noise_std_rad_s", "gyro_bias_rad_s", "accelerometer_noise_std_m_s2", "accelerometer_bias_m_s2", "base_period_s", "imu_period_ticks", "config_path"],
      "properties": {
        "inertia_kg_m2": {"$ref": "#/$defs/mat3"}, "actuator_time_constant_s": {"$ref": "#/$defs/float64"}, "actuator_limits_Nm": {"$ref": "#/$defs/vec3"},
        "gravity_n_m_s2": {"$ref": "#/$defs/vec3"}, "gyro_noise_std_rad_s": {"$ref": "#/$defs/vec3"}, "gyro_bias_rad_s": {"$ref": "#/$defs/vec3"},
        "accelerometer_noise_std_m_s2": {"$ref": "#/$defs/vec3"}, "accelerometer_bias_m_s2": {"$ref": "#/$defs/vec3"},
        "base_period_s": {"$ref": "#/$defs/float64"}, "imu_period_ticks": {"$ref": "#/$defs/tick"}, "config_path": {"$ref": "#/$defs/id"}
      }
    },
    "estimator_parameter_values": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_period_s", "gravity_m_s2", "unit_norm_tolerance", "correction_gain_per_s", "accelerometer_gate_deviation_m_s2", "maximum_correction_step_rad", "timestamp_tolerance_s", "config_path", "g0_config_path"],
      "properties": {
        "sample_period_s": {"$ref": "#/$defs/float64"}, "gravity_m_s2": {"$ref": "#/$defs/float64"}, "unit_norm_tolerance": {"$ref": "#/$defs/float64"},
        "correction_gain_per_s": {"$ref": "#/$defs/float64"}, "accelerometer_gate_deviation_m_s2": {"$ref": "#/$defs/float64"},
        "maximum_correction_step_rad": {"$ref": "#/$defs/float64"}, "timestamp_tolerance_s": {"$ref": "#/$defs/float64"},
        "config_path": {"$ref": "#/$defs/id"}, "g0_config_path": {"$ref": "#/$defs/id"}
      }
    },
    "controller_parameter_values": {
      "type": "object", "additionalProperties": false,
      "required": ["attitude_kp", "rate_kp", "rate_ki", "rate_kd", "integral_limit_Nm", "rate_limit_rad_s", "torque_limit_Nm", "kaw_limit_per_s", "kaw_lag_per_s", "derivative_time_constant_s", "controller_period_s", "timestamp_tolerance_s", "quaternion_norm_tolerance"],
      "properties": {
        "attitude_kp": {"$ref": "#/$defs/vec3"}, "rate_kp": {"$ref": "#/$defs/vec3"}, "rate_ki": {"$ref": "#/$defs/vec3"}, "rate_kd": {"$ref": "#/$defs/vec3"},
        "integral_limit_Nm": {"$ref": "#/$defs/vec3"}, "rate_limit_rad_s": {"$ref": "#/$defs/vec3"}, "torque_limit_Nm": {"$ref": "#/$defs/vec3"},
        "kaw_limit_per_s": {"$ref": "#/$defs/vec3"}, "kaw_lag_per_s": {"$ref": "#/$defs/vec3"},
        "derivative_time_constant_s": {"$ref": "#/$defs/float64"}, "controller_period_s": {"$ref": "#/$defs/float64"},
        "timestamp_tolerance_s": {"$ref": "#/$defs/float64"}, "quaternion_norm_tolerance": {"$ref": "#/$defs/float64"}
      }
    },
    "constructor_arguments": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "mode", "parameter_object_ref", "module_sha256"],
      "properties": {
        "kind": {"const": "constructor"}, "mode": {"enum": ["explicit_parameters", "parameter_fields", "default_loader", "controller_module", "empty"]},
        "parameter_object_ref": {"$ref": "#/$defs/nullable_ref"}, "module_sha256": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "loader_arguments": {
      "type": "object", "additionalProperties": false, "required": ["kind", "supplied_args"],
      "properties": {
        "kind": {"const": "loader"}, "supplied_args": {"type": "array", "uniqueItems": true, "items": {"enum": ["config_path", "module", "track"]}},
        "config_path": {"$ref": "#/$defs/nullable_ref"}, "track": {"$ref": "#/$defs/nullable_ref"}, "module_sha256": {"$ref": "#/$defs/nullable_sha256"}
      },
      "description": "Preserve omitted argument versus explicit null according to supplied_args; exact owner/callsite signature is independently checked."
    },
    "config_arguments": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "actual_argument_kind", "path_argument", "source_artifact_ref", "source_bytes_sha256", "document_sha256"],
      "properties": {
        "kind": {"const": "config"}, "actual_argument_kind": {"enum": ["path", "document"]},
        "path_argument": {"$ref": "#/$defs/nullable_ref"}, "source_artifact_ref": {"$ref": "#/$defs/nullable_ref"},
        "source_bytes_sha256": {"$ref": "#/$defs/nullable_sha256"}, "document_sha256": {"$ref": "#/$defs/nullable_sha256"}
      },
      "description": "load_config consumes an actual path; validate_config consumes actual parsed document. Source byte and document value bindings are both checked, not invented by raw."
    },
    "observer_arguments": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "snapshot_id", "capture_id", "observer_manifest_sha256"],
      "properties": {"kind": {"const": "observer"}, "snapshot_id": {"$ref": "#/$defs/id"}, "capture_id": {"$ref": "#/$defs/id"}, "observer_manifest_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "lifecycle_result": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "parameter_object_ref", "snapshot_ref", "capture_id", "resolved_config_path", "source_bytes_sha256", "document_sha256"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/nullable_ref"}, "parameter_object_ref": {"$ref": "#/$defs/nullable_ref"},
        "snapshot_ref": {"$ref": "#/$defs/nullable_ref"}, "capture_id": {"$ref": "#/$defs/nullable_ref"},
        "resolved_config_path": {"$ref": "#/$defs/nullable_ref"}, "source_bytes_sha256": {"$ref": "#/$defs/nullable_sha256"}, "document_sha256": {"$ref": "#/$defs/nullable_sha256"}
      },
      "description": "A returned None is a return event with inapplicable result fields null, not a missing observation. No private core parameter readback is inferred."
    },
    "lifecycle_exception": {
      "type": "object", "additionalProperties": false, "required": ["type", "reason", "message"],
      "properties": {"type": {"$ref": "#/$defs/id"}, "reason": {"type": ["string", "null"]}, "message": {"type": "string"}}
    },
    "lifecycle_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_index", "call_id", "parent_call_id", "profile_id", "operation_id", "owner", "method", "event", "callsite", "actor_id", "core_use", "arguments", "result", "exception"],
      "properties": {
        "observation_index": {"$ref": "#/$defs/tick"}, "call_id": {"$ref": "#/$defs/id"}, "parent_call_id": {"$ref": "#/$defs/nullable_ref"},
        "profile_id": {"enum": [null, "S", "L1", "L2", "O1", "O2", "E", "T1", "T2"]}, "operation_id": {"$ref": "#/$defs/nullable_ref"},
        "owner": {"enum": ["plant", "actuator", "imu", "estimator", "controller", "controller_core", "g1_parameters", "estimator_parameters", "controller_parameters", "g1_loader", "estimator_loader", "controller_loader", "g0_validator", "observer", "session"]},
        "method": {"enum": ["constructor", "load_parameters", "load_config", "validate_config", "capture_snapshot", "reset"]},
        "event": {"enum": ["enter", "return", "exception"]}, "callsite": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/nullable_ref"},
        "core_use": {"enum": [null, "temporary_validation", "production"]},
        "arguments": {"anyOf": [{"$ref": "#/$defs/constructor_arguments"}, {"$ref": "#/$defs/loader_arguments"}, {"$ref": "#/$defs/config_arguments"}, {"$ref": "#/$defs/observer_arguments"}, {"$ref": "#/$defs/reset_inputs"}, {"type": "null"}]},
        "result": {"anyOf": [{"$ref": "#/$defs/lifecycle_result"}, {"type": "null"}]},
        "exception": {"anyOf": [{"$ref": "#/$defs/lifecycle_exception"}, {"type": "null"}]}
      },
      "description": "Enter carries actual arguments, return carries actual result binding, exception carries original error. Semantics enforce matching event/owner/method/purpose/parent and complete coverage."
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["work_order_sha256", "source_commit", "source_tree", "source_closure_manifest_sha256", "config_approval_manifest_sha256", "profile_definition_sha256", "parameter_inputs_manifest_sha256", "observer_manifest_sha256", "environment_manifest_sha256", "f0_manifest_sha256", "controller_module_path", "controller_module_sha256", "controller_module_abi", "build_type", "seed", "classification"],
      "properties": {
        "work_order_sha256": {"$ref": "#/$defs/sha256"},
        "source_commit": {"$ref": "#/$defs/git_sha1"},
        "source_tree": {"$ref": "#/$defs/git_sha1"},
        "source_closure_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "config_approval_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "profile_definition_sha256": {"$ref": "#/$defs/sha256"},
        "parameter_inputs_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "observer_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "environment_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "f0_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "controller_module_path": {"$ref": "#/$defs/id"},
        "controller_module_sha256": {"$ref": "#/$defs/sha256"},
        "controller_module_abi": {"$ref": "#/$defs/id"},
        "build_type": {"enum": ["Debug", "Release"]},
        "seed": {"const": 2026100900},
        "classification": {"const": "development_integration_not_normal_acceptance"}
      }
    },
    "conventions": {
      "type": "object", "additionalProperties": false,
      "required": ["navigation_frame", "body_frame", "quaternion", "time", "angular_rate", "angular_acceleration", "torque", "torque_rate", "specific_force", "inertia"],
      "properties": {
        "navigation_frame": {"type": "string"}, "body_frame": {"type": "string"},
        "quaternion": {"type": "string"}, "time": {"type": "string"},
        "angular_rate": {"type": "string"}, "angular_acceleration": {"type": "string"},
        "torque": {"type": "string"}, "torque_rate": {"type": "string"},
        "specific_force": {"type": "string"}, "inertia": {"type": "string"}
      },
      "description": "Semantic exact literals: NED, FRD, scalar_first_Hamilton_q_nb_body_to_NED, s, rad/s, rad/s2, Nm, Nm/s, m/s2, kg*m2 respectively. Bad literals retain an owning frame/unit diagnostic."
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "horizon_tick", "reset_ticks", "initial_inputs", "wires", "boundaries", "probes", "snapshots", "reported_counts"],
      "properties": {
        "profile_id": {"enum": ["S", "L1", "L2", "O1", "O2", "E", "T1", "T2"]},
        "horizon_tick": {"$ref": "#/$defs/tick"},
        "reset_ticks": {"type": "array", "items": {"$ref": "#/$defs/tick"}},
        "initial_inputs": {"$ref": "#/$defs/initial_inputs"},
        "wires": {"type": "array", "items": {"$ref": "#/$defs/wire"}},
        "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
        "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
        "snapshots": {"type": "array", "items": {"$ref": "#/$defs/snapshot"}},
        "reported_counts": {"$ref": "#/$defs/counts"}
      }
    },
    "initial_inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["plant_q_nb", "plant_omega_b_rad_s", "estimator_q_nb", "estimator_omega_b_rad_s", "actuator_actual_torque_body_Nm", "attitude_command_q_nb", "reset_local_command_q_nb", "epoch_id", "epoch_origin_tick", "epoch_origin_s", "source_refs"],
      "properties": {
        "plant_q_nb": {"$ref": "#/$defs/quat"}, "plant_omega_b_rad_s": {"$ref": "#/$defs/vec3"},
        "estimator_q_nb": {"$ref": "#/$defs/quat"}, "estimator_omega_b_rad_s": {"$ref": "#/$defs/vec3"},
        "actuator_actual_torque_body_Nm": {"$ref": "#/$defs/vec3"},
        "attitude_command_q_nb": {"$ref": "#/$defs/quat"}, "reset_local_command_q_nb": {"$ref": "#/$defs/quat"},
        "epoch_id": {"$ref": "#/$defs/tick"}, "epoch_origin_tick": {"$ref": "#/$defs/tick"},
        "epoch_origin_s": {"$ref": "#/$defs/float64"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "wire": {
      "type": "object", "additionalProperties": false,
      "required": ["wire_id", "kind", "role", "producer", "parent_ids", "epoch_id", "global_tick", "local_tick", "phase", "producer_operation_id", "producer_field", "payload"],
      "properties": {
        "wire_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["plant_state", "sensor_truth", "torque_command", "feedback", "imu", "estimate", "attitude_command", "estimator_diagnostics", "controller_diagnostics"]},
        "role": {"enum": ["plant_state", "sensor_truth", "held_torque", "feedback", "imu", "estimate", "attitude_command", "estimator_diagnostics", "controller_diagnostics"]},
        "producer": {"$ref": "#/$defs/id"}, "parent_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "epoch_id": {"$ref": "#/$defs/tick"}, "global_tick": {"$ref": "#/$defs/tick"},
        "local_tick": {"$ref": "#/$defs/tick"},
        "phase": {"type": "integer", "minimum": 0, "maximum": 6},
        "producer_operation_id": {"$ref": "#/$defs/nullable_ref"}, "producer_field": {"$ref": "#/$defs/id"},
        "payload": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "plant_state"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/plant_state"}}}},
        {"if": {"properties": {"kind": {"const": "sensor_truth"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/sensor_truth"}}}},
        {"if": {"properties": {"kind": {"const": "torque_command"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/torque_command"}}}},
        {"if": {"properties": {"kind": {"const": "feedback"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/feedback"}}}},
        {"if": {"properties": {"kind": {"const": "imu"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/imu"}}}},
        {"if": {"properties": {"kind": {"const": "estimate"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/estimate"}}}},
        {"if": {"properties": {"kind": {"const": "attitude_command"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/attitude_command"}}}},
        {"if": {"properties": {"kind": {"const": "estimator_diagnostics"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/estimator_diagnostics"}}}},
        {"if": {"properties": {"kind": {"const": "controller_diagnostics"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/controller_diagnostics"}}}}
      ]
    },
    "plant_state": {
      "type": "object", "additionalProperties": false,
      "required": ["q_nb", "omega_b_rad_s", "timestamp_s"],
      "properties": {"q_nb": {"$ref": "#/$defs/quat"}, "omega_b_rad_s": {"$ref": "#/$defs/vec3"}, "timestamp_s": {"$ref": "#/$defs/float64"}}
    },
    "sensor_truth": {
      "type": "object", "additionalProperties": false,
      "required": ["q_nb", "omega_b_rad_s", "translational_acceleration_n_m_s2"],
      "properties": {"q_nb": {"$ref": "#/$defs/quat"}, "omega_b_rad_s": {"$ref": "#/$defs/vec3"}, "translational_acceleration_n_m_s2": {"$ref": "#/$defs/vec3"}}
    },
    "torque_command": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_torque_body_Nm", "limited_torque_body_Nm", "saturated", "timestamp_s"],
      "properties": {"requested_torque_body_Nm": {"$ref": "#/$defs/vec3"}, "limited_torque_body_Nm": {"$ref": "#/$defs/vec3"}, "saturated": {"$ref": "#/$defs/flags3"}, "timestamp_s": {"$ref": "#/$defs/float64"}}
    },
    "feedback": {
      "type": "object", "additionalProperties": false,
      "required": ["actual_torque_body_Nm", "limited_torque_body_Nm", "saturated", "timestamp_s", "command_timestamp_s"],
      "properties": {"actual_torque_body_Nm": {"$ref": "#/$defs/vec3"}, "limited_torque_body_Nm": {"$ref": "#/$defs/vec3"}, "saturated": {"$ref": "#/$defs/flags3"}, "timestamp_s": {"$ref": "#/$defs/float64"}, "command_timestamp_s": {"$ref": "#/$defs/float64"}}
    },
    "imu": {
      "type": "object", "additionalProperties": false,
      "required": ["gyro_rad_s", "specific_force_m_s2", "timestamp_s", "valid"],
      "properties": {"gyro_rad_s": {"$ref": "#/$defs/vec3"}, "specific_force_m_s2": {"$ref": "#/$defs/vec3"}, "timestamp_s": {"$ref": "#/$defs/float64"}, "valid": {"type": "boolean"}}
    },
    "estimate": {
      "type": "object", "additionalProperties": false,
      "required": ["q_nb", "omega_b_rad_s", "timestamp_s", "valid"],
      "properties": {"q_nb": {"$ref": "#/$defs/quat"}, "omega_b_rad_s": {"$ref": "#/$defs/vec3"}, "timestamp_s": {"$ref": "#/$defs/float64"}, "valid": {"type": "boolean"}}
    },
    "attitude_command": {
      "type": "object", "additionalProperties": false,
      "required": ["q_nb", "timestamp_s", "valid"],
      "properties": {"q_nb": {"$ref": "#/$defs/quat"}, "timestamp_s": {"$ref": "#/$defs/float64"}, "valid": {"type": "boolean"}}
    },
    "estimator_diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted", "reason", "correction_eligible", "correction_applied", "correction_capped", "elapsed_periods", "missing_periods", "gap_approximated"],
      "properties": {"accepted": {"type": "boolean"}, "reason": {"type": "string"}, "correction_eligible": {"type": "boolean"}, "correction_applied": {"type": "boolean"}, "correction_capped": {"type": "boolean"}, "elapsed_periods": {"$ref": "#/$defs/tick"}, "missing_periods": {"$ref": "#/$defs/tick"}, "gap_approximated": {"type": "boolean"}}
    },
    "controller_diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted", "reason", "rate_error_rad_s", "derivative_raw_rad_s2", "derivative_filtered_rad_s2", "proportional_Nm", "integral_before_Nm", "derivative_Nm", "conditional_integral_rate_Nm_s", "limit_backcalculation_rate_Nm_s", "lag_backcalculation_rate_Nm_s", "integral_after_Nm", "requested_Nm", "limited_Nm", "saturated", "epoch_id", "tick_index"],
      "properties": {
        "accepted": {"type": "boolean"}, "reason": {"type": "string"},
        "rate_error_rad_s": {"$ref": "#/$defs/vec3"}, "derivative_raw_rad_s2": {"$ref": "#/$defs/vec3"}, "derivative_filtered_rad_s2": {"$ref": "#/$defs/vec3"},
        "proportional_Nm": {"$ref": "#/$defs/vec3"}, "integral_before_Nm": {"$ref": "#/$defs/vec3"}, "derivative_Nm": {"$ref": "#/$defs/vec3"},
        "conditional_integral_rate_Nm_s": {"$ref": "#/$defs/vec3"}, "limit_backcalculation_rate_Nm_s": {"$ref": "#/$defs/vec3"}, "lag_backcalculation_rate_Nm_s": {"$ref": "#/$defs/vec3"},
        "integral_after_Nm": {"$ref": "#/$defs/vec3"}, "requested_Nm": {"$ref": "#/$defs/vec3"}, "limited_Nm": {"$ref": "#/$defs/vec3"},
        "saturated": {"$ref": "#/$defs/flags3"}, "epoch_id": {"type": "integer"}, "tick_index": {"$ref": "#/$defs/tick"}
      }
    },
    "event_inputs": {
      "type": "object", "additionalProperties": false,
