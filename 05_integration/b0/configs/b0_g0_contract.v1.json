  "actuator_contract": {
    "source_ref": "SYNTH-ACTUATOR-001",
    "implementation_status": "future_g1_contract_only",
    "requested_torque": "requested_torque_body_Nm",
    "limited_target_torque": "limited_torque_body_Nm",
    "actual_torque": "actual_torque_body_Nm",
    "model": "first_order_bounded",
    "time_constant_s": 0.03,
    "limits_Nm": [
      0.35,
      0.35,
      0.2
    ],
    "antiwindup": {
      "strategy": "conditional_integration_plus_back_calculation",
      "integrator_state": "integral_torque_contribution_body_Nm",
      "discrete_update": "I_next=clamp(I+dt*(conditional_ki_rate_error+kaw_limit*(limited_target-requested)+kaw_lag*(actual-limited_target)),-I_limit,I_limit)",
      "conditional_integration": {
        "block_when": "requested_minus_limited_has_same_sign_as_rate_error",
        "allow_when": "not_limited_or_rate_error_reduces_saturation"
      },
      "limit_feedback": {
        "signal": "limited_target_minus_requested_torque_body_Nm",
        "availability": "same_controller_tick_after_componentwise_limit",
        "gain_per_s": [
          8,
          8,
          8
        ]
      },
      "actuator_lag_feedback": {
        "signal": "actual_minus_limited_target_torque_body_Nm",
        "availability": "actuator_state_after_current_tick_advance_from_previous_limited_target",
        "delay_ticks": 1,
        "gain_per_s": [
          2,
          2,
          2
        ]
      },
      "reset_value_Nm": [
        0,
        0,
        0
      ]
    },
    "parameter_rationale": "Synthetic torque limits and 0.03 s lag create a bounded abstract torque interface; their role is to exercise saturation and lag semantics, not model motors."
  },
