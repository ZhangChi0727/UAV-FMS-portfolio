  "acceptance_policy": {
    "source_ref": "SYNTH-SCENARIO-001",
    "status": "proposed_pending_maintainer_approval",
    "attitude_error": {
      "sign_equivalent_angle_formula": "2*acos(clamp(abs(dot(q_reference,q_candidate)),0,1))",
      "unit": "rad"
    },
    "settling": {
      "band_rad": 0.0174533,
      "dwell_s": 0.25,
      "command_step_time_origin": "event_start_tick",
      "disturbance_recovery_time_origin": "event_end_tick",
      "initial_offset_time_origin": "scenario_tick_zero",
      "entry_rule": "first sample inside band that remains inside for the full dwell interval",
      "deadline_rule": "window_must_include_limit_plus_dwell_after_the_applicable_origin",
      "unfinished_action": "performance_fail",
      "missing_data_action": "execution_error_inconclusive"
    },
    "overshoot": {
      "reference": "signed_command_delta_from_pre_event_command_to_event_target",
      "denominator": "absolute_value_of_signed_command_delta",
      "direction": "project_tracking_error_along_signed_command_delta",
      "zero_command_action": "not_applicable",
      "missing_data_action": "execution_error_inconclusive",
      "unit": "percent"
    },
    "outcome_classes": [
      "performance_pass",
      "performance_fail",
      "limitation_characterized",
      "invalid_input_rejected",
      "execution_error_inconclusive"
    ],
    "saturation": {
      "trigger_definition": "any_axis_abs_requested_torque_exceeds_limit_and_limited_torque_equals_componentwise_clamp",
      "trigger_coverage_rule": "saturation_withdrawal_requires_positive_duration_during_its_command_event",
      "missing_data_action": "execution_error_inconclusive"
    },
    "metric_definitions": {
      "attitude_error_rad": {
        "source_signals": [
          "q_nb_truth",
          "q_nb_command"
        ],
        "formula": "2*acos(clamp(abs(dot(q_nb_command,q_nb_truth)),0,1))",
        "axis_aggregation": "not_applicable",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "attitude_settling_time_s": {
        "source_signals": [
          "q_nb_truth",
          "q_nb_command"
        ],
        "formula": "settling_policy_angle_error_with_subject_specific_time_origin",
        "axis_aggregation": "per_subject_then_criterion_reducer",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "body_rate_error_rad_s": {
        "source_signals": [
          "omega_b_truth_rad_s",
          "omega_b_estimate_rad_s"
        ],
        "formula": "componentwise_truth_minus_estimate_body_rate",
        "axis_aggregation": "componentwise_before_reducer",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "quaternion_norm_error": {
        "source_signals": [
          "q_nb_estimate"
        ],
        "formula": "abs(norm(q_nb_estimate)-1)",
        "axis_aggregation": "not_applicable",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "tracking_settling_time_s": {
        "source_signals": [
          "q_nb_truth",
          "q_nb_command"
        ],
        "formula": "settling_policy_angle_error_from_command_step_start",
        "axis_aggregation": "per_command_step",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "tracking_overshoot_percent": {
        "source_signals": [
          "q_nb_truth",
          "q_nb_command"
        ],
        "formula": "100*maximum_positive_signed_tracking_excursion/abs(signed_command_delta)",
        "axis_aggregation": "per_command_step",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "cross_axis_attitude_error_rad": {
        "source_signals": [
          "q_nb_truth",
          "q_nb_command"
        ],
        "formula": "maximum_abs_uncommanded_axis_error_relative_to_commanded_step_axis",
        "axis_aggregation": "max_over_noncommanded_axes",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "actuator_saturation_time_s": {
        "source_signals": [
          "requested_torque_Nm",
          "limited_torque_Nm"
        ],
        "formula": "sum_dt_where_saturation_trigger_definition_is_true",
        "axis_aggregation": "sum_over_axes_per_tick_then_time",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "roll_pitch_estimation_error_rad": {
        "source_signals": [
          "q_nb_truth",
          "q_nb_estimate"
        ],
        "formula": "roll_pitch_components_of_sign_equivalent_truth_to_estimate_error",
        "axis_aggregation": "rms_over_roll_and_pitch_reported_per_axis",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "yaw_drift_rad_s": {
        "source_signals": [
          "q_nb_truth",
          "q_nb_estimate"
        ],
        "formula": "time_derivative_of_relative_yaw_error_with_initial_yaw_reference",
        "axis_aggregation": "signed_yaw_axis",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "controller_integral_Nm": {
        "source_signals": [
          "controller_integral_Nm"
        ],
        "formula": "componentwise_integral_torque_contribution",
        "axis_aggregation": "max_abs_over_axes",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "limitation_event_recorded": {
        "source_signals": [
          "imu_specific_force_m_s2",
          "limitation_status",
          "q_nb_truth",
          "q_nb_estimate"
        ],
        "formula": "all_samples_record_additive_specific_force_event_and_limitation_status",
        "axis_aggregation": "all_over_event_window",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "invalid_input_rejection_count": {
        "source_signals": [
          "sample_validity",
          "rejection_reason"
        ],
        "formula": "count_declared_invalid_events_with_explicit_rejection_reason",
        "axis_aggregation": "count_over_scenario",
        "invalid_data_action": "execution_error_inconclusive"
      },
      "reset_replay_match": {
        "source_signals": [
          "reset_epoch",
          "q_nb_estimate"
        ],
        "formula": "post_reset_trace_matches_same_seed_and_explicit_initialization_replay",
        "axis_aggregation": "all_over_post_reset_window",
        "invalid_data_action": "execution_error_inconclusive"
      }
    }
