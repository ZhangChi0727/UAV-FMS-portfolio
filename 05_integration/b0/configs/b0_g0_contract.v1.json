  "conventions": {
    "world_frame": "NED",
    "body_frame": "FRD",
    "units": "SI",
    "quaternion": {
      "name": "q_nb",
      "representation": "scalar_first_hamilton",
      "rotation": "body_to_ned",
      "normalization_required": true,
      "sign_policy": "canonical_scalar_nonnegative_then_first_nonzero_vector_positive",
      "unit_norm_tolerance": 1e-06
    },
    "body_angular_rate": {
      "name": "omega_b",
      "frame": "body_frd",
      "unit": "rad/s"
    }
  },
  "timing": {
    "source_ref": "SYNTH-TIME-001",
    "base_period_s": 0.0025,
    "schedules": {
      "plant_every_ticks": 1,
      "actuator_every_ticks": 1,
      "imu_every_ticks": 2,
      "estimator_every_ticks": 2,
      "controller_every_ticks": 2
    },
    "sequence": [
      "plant_consumes_actual_torque_for_interval",
      "actuator_advances_previous_limited_target",
      "imu_samples_interval_end_when_due",
      "estimator_consumes_imu_when_due",
      "controller_consumes_current_estimate_when_due",
      "controller_publishes_next_limited_target"
    ],
    "timestamp_policy": {
      "strictly_increasing": true,
      "nonpositive_dt_action": "reject_sample",
      "stale_timestamp_action": "reject_sample_preserve_last_valid_state",
      "reset_action": "clear_internal_state_then_require_explicit_initialization"
    },
    "sample_consumption_policy": {
      "estimator_period_relation": "estimator_every_ticks_must_equal_imu_every_ticks",
      "estimator_no_new_imu_action": "not_scheduled",
      "controller_estimate_requirement": "consume_estimate_from_current_due_imu_sample",
      "controller_estimate_age_max_ticks": 0
    },
    "event_tick_semantics": {
      "start_tick": "inclusive",
      "end_tick": "exclusive",
      "event_order": "nondecreasing_start_tick_then_declaration_order",
      "same_signal_overlap": "reject",
      "allowed_cross_type_overlap_pairs": [],
      "command_after_event": "return_affected_axis_to_zero"
    }
  },
  "interface_contract": {
    "source_ref": "BASELINE-G0-001",
    "numeric_type": "float64",
    "timestamp_unit": "s",
    "validity_encoding": "explicit_boolean_no_implicit_default",
    "messages": {
      "attitude_command": [
        {
          "name": "timestamp_s",
          "type": "float64",
          "shape": "scalar",
          "unit": "s",
          "frame": "scenario_clock",
          "validity": "finite_and_strictly_increasing"
        },
        {
          "name": "q_nb_command",
          "type": "float64",
          "shape": "length_4",
          "unit": "1",
          "frame": "body_to_ned",
          "validity": "unit_quaternion"
        },
        {
          "name": "valid",
          "type": "bool",
          "shape": "scalar",
          "unit": "bool",
          "frame": "not_applicable",
          "validity": "must_be_true_for_controller_step"
        }
      ],
      "imu_sample": [
        {
          "name": "timestamp_s",
          "type": "float64",
          "shape": "scalar",
          "unit": "s",
          "frame": "scenario_clock",
          "validity": "finite_and_strictly_increasing"
        },
        {
          "name": "gyro_b_rad_s",
          "type": "float64",
          "shape": "length_3",
          "unit": "rad/s",
          "frame": "body_frd",
          "validity": "all_finite"
        },
        {
          "name": "specific_force_b_m_s2",
          "type": "float64",
          "shape": "length_3",
          "unit": "m/s2",
          "frame": "body_frd",
          "validity": "all_finite"
        },
        {
          "name": "valid",
          "type": "bool",
          "shape": "scalar",
          "unit": "bool",
          "frame": "not_applicable",
          "validity": "false_means_reject_without_state_change"
        }
      ],
      "state_estimate": [
        {
          "name": "timestamp_s",
          "type": "float64",
          "shape": "scalar",
          "unit": "s",
          "frame": "scenario_clock",
          "validity": "finite_and_strictly_increasing"
        },
        {
          "name": "q_nb_estimate",
          "type": "float64",
          "shape": "length_4",
          "unit": "1",
          "frame": "body_to_ned",
          "validity": "unit_quaternion"
        },
        {
          "name": "omega_b_estimate_rad_s",
          "type": "float64",
          "shape": "length_3",
          "unit": "rad/s",
          "frame": "body_frd",
          "validity": "all_finite"
        },
        {
          "name": "valid",
          "type": "bool",
          "shape": "scalar",
          "unit": "bool",
          "frame": "not_applicable",
          "validity": "must_be_true_for_controller_step"
        }
      ],
      "torque_request": [
        {
          "name": "timestamp_s",
          "type": "float64",
          "shape": "scalar",
          "unit": "s",
          "frame": "scenario_clock",
          "validity": "finite_and_strictly_increasing"
        },
        {
          "name": "requested_torque_body_Nm",
          "type": "float64",
          "shape": "length_3",
          "unit": "Nm",
          "frame": "body_frd",
          "validity": "all_finite_pre_limit"
        }
      ],
      "actuator_feedback": [
        {
          "name": "timestamp_s",
          "type": "float64",
          "shape": "scalar",
          "unit": "s",
          "frame": "scenario_clock",
          "validity": "finite_and_strictly_increasing"
        },
        {
          "name": "limited_torque_body_Nm",
          "type": "float64",
          "shape": "length_3",
          "unit": "Nm",
          "frame": "body_frd",
          "validity": "componentwise_within_limit"
        },
        {
          "name": "actual_torque_body_Nm",
          "type": "float64",
          "shape": "length_3",
          "unit": "Nm",
          "frame": "body_frd",
          "validity": "componentwise_within_limit"
        },
        {
          "name": "saturated",
          "type": "bool",
          "shape": "length_3",
          "unit": "bool",
          "frame": "body_frd",
          "validity": "true_when_request_exceeds_component_limit"
        }
      ]
    },
    "component_calls": {
      "plant": {
        "reset": "reset(PlantInitialState, reset_epoch) -> PlantState; invalid input raises ContractValidationError without state change",
        "step": "step(actual_torque_body_Nm, dt_s) -> PlantState; advances exactly one base interval"
      },
      "actuator": {
        "reset": "reset(ActuatorInitialState, reset_epoch) -> ActuatorFeedback; invalid input raises ContractValidationError without state change",
        "step": "step(limited_torque_body_Nm, dt_s) -> ActuatorFeedback; advances exactly one base interval"
      },
      "estimator": {
        "reset": "reset(EstimatorInitialState, reset_epoch, rng_seed) -> StateEstimate; no live truth argument",
        "step": "step(imu_sample) -> StateEstimate; invalid or stale sample is rejected without state change"
      },
      "controller": {
        "reset": "reset(ControllerInitialState, reset_epoch) -> TorqueRequest; invalid input raises ContractValidationError without state change",
        "step": "step(attitude_command, state_estimate, actuator_feedback, dt_s) -> TorqueRequest; no truth argument"
      }
    }
  },
