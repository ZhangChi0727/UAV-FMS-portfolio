{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/uav-fms/b0-requirements.schema.json",
  "title": "B0 formal requirement candidate source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline_status", "d1_approval_ref", "sources", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_status": {"const": "candidate_pending_d2"},
    "d1_approval_ref": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "revision", "locator", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^B0-SRC-[A-Z0-9-]+$"},
          "path": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "locator": {"type": "string", "minLength": 1},
          "role": {"enum": ["intent", "g0_contract", "approval", "architecture", "verification_plan", "historical", "implementation_evidence"]}
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "level", "status", "statement", "rationale", "source_ids", "applicability", "responsible_components", "model_element_ids", "verification_ids", "acceptance_condition", "legacy_refs", "parent_id", "supersedes", "change_note"],
      "properties": {
        "id": {"type": "string", "pattern": "^B0-REQ-[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1},
        "type": {"enum": ["functional", "interface", "performance", "constraint", "quality", "process", "applicability"]},
        "level": {"enum": ["stakeholder", "system", "component"]},
        "status": {"const": "candidate_pending_d2"},
        "statement": {"type": "string", "pattern": "^The B0 (system|[A-Za-z ]+) shall .+"},
        "rationale": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "scope", "approval_ref"],
          "properties": {
            "state": {"enum": ["applicable", "not_applicable", "conditional"]},
            "scope": {"type": "string", "minLength": 1},
            "approval_ref": {"type": ["string", "null"]}
          }
        },
        "responsible_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^B0-MODEL-[A-Z0-9-]+$"}},
        "model_element_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^B0-MODEL-[A-Z0-9-]+$"}},
        "verification_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^B0-VER-[A-Z0-9-]+$"}},
        "acceptance_condition": {"type": "string", "minLength": 1},
        "legacy_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(NAV|CTL|FDI)-REQ-[0-9]{3}$"}},
        "parent_id": {"type": ["string", "null"], "pattern": "^B0-REQ-[0-9]{4}$"},
        "supersedes": {"type": ["string", "null"]},
        "change_note": {"type": "string", "minLength": 1}
      }
    }
  }
}
